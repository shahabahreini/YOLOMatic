# Copy to .env in your project folder. Never commit .env.

# --- Roboflow (model and dataset upload) -----------------------------------
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT_IDS=

# --- Ultralytics Platform (dataset/model download and upload) --------------
ULTRALYTICS_API_KEY=

# --- Hugging Face (SAM 3.1 weights are gated; accept the license first) ----
HF_TOKEN=

# --- AI recommendations (optional; can also be set in Settings > AI, which
#     stores them in your OS keychain) -------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- YOLOmatic behaviour (all optional) -------------------------------------
# YOLOMATIC_DEBUG=1        verbose logging and on-screen tracebacks
# YOLOMATIC_LOG_DIR=       session log folder (default: the OS user log dir)
# YOLOMATIC_ASCII=1        plain ASCII symbols for legacy terminals
# YOLOMATIC_MOUSE=1        enable mouse-wheel scrolling (disables text selection)
# YOLOMATIC_KEYRING=0      never use the OS credential store for API keys
# NO_COLOR=1               disable colours

# Global integration behaviour is configured in configs/yolomatic_settings.yaml
# or Maintenance > Settings in the TUI.
